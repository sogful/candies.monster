+        private void previewcamera(XElement map, float scale)
+        {
+            if (!CustomLevelSession.IsActive) return;
+            float left = cameraBounds.x;
+            float top = cameraBounds.y;
+            float right = left + cameraBounds.w;
+            float bottom = top + cameraBounds.h;
+            foreach (XElement layer in map.Elements("layer"))
+            {
+                if (layer.Attribute("name")?.Value == "settings") continue;
+                foreach (XElement item in layer.Elements())
+                {
+                    if (item.Name.LocalName.StartsWith("tutorial", System.StringComparison.OrdinalIgnoreCase)) continue;
+                    if (!float.TryParse(item.Attribute("x")?.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out float x)
+                        || !float.TryParse(item.Attribute("y")?.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out float y)) continue;
+                    x = (x * scale) + mapOriginX;
+                    y = (y * scale) + mapOriginY;
+                    if (!float.IsFinite(x) || !float.IsFinite(y)) continue;
+                    float tolerance = 32f * scale;
+                    if (x < left - tolerance) left = x;
+                    if (y < top - tolerance) top = y;
+                    if (x > right + tolerance) right = x;
+                    if (y > bottom + tolerance) bottom = y;
+                }
+            }
+            cameraBounds = new Rectangle(left, top, right - left, bottom - top);
+            previewwindow(ScreenPresentation.Instance.Snapshot);
+        }
